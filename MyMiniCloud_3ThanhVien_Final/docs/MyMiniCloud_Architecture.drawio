        <mxCell id="web1" value="&lt;b&gt;🌍  web-frontend-server&lt;/b&gt;&lt;br/&gt;Nginx Static Site&lt;br/&gt;IP: 10.10.10.10&lt;br/&gt;Host :8080 → :80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AED6F1;strokeColor=#2980B9;strokeWidth=2;fontSize=10;arcSize=10;shadow=1;" vertex="1" parent="1">
