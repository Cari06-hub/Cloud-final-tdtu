        </mxCell>

        <!-- Web Server 2 -->
        <mxCell id="web2" value="&lt;b&gt;🌍  web-frontend-server2&lt;/b&gt;&lt;br/&gt;Nginx Static Site (Server 2)&lt;br/&gt;Round Robin peer&lt;br/&gt;(no host port)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2980B9;strokeWidth=2;fontSize=10;arcSize=10;shadow=1;dashed=1;" vertex="1" parent="1">
