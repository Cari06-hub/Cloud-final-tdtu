        <!-- Flask Backend -->
        <mxCell id="flask" value="&lt;b&gt;🐍  application-backend-server&lt;/b&gt;&lt;br/&gt;Flask Python API&lt;br/&gt;IP: 10.10.10.20&lt;br/&gt;Host :8085 → :8081&lt;br/&gt;Routes: /hello /student /students-db /secure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAD7A0;strokeColor=#E67E22;strokeWidth=2;fontSize=10;arcSize=10;shadow=1;" vertex="1" parent="1">
