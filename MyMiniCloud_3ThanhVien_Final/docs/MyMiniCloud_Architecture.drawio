        <!-- ==================== TIER 1: API GATEWAY ==================== -->
        <mxCell id="gateway" value="&lt;b&gt;🔀  api-gateway-proxy-server&lt;/b&gt;&lt;br/&gt;Nginx Reverse Proxy + Round Robin Load Balancer&lt;br/&gt;Host :&lt;b&gt;80&lt;/b&gt; → container :80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#27AE60;strokeWidth=2;fontSize=11;arcSize=8;shadow=1;" vertex="1" parent="1">
