; ===========================================================
; Zone file cho cloud.local – MyMiniCloud Internal DNS
; Maintainer: Tuấn Anh (TV2)
; ===========================================================

$TTL    604800

@       IN      SOA     ns.cloud.local. admin.cloud.local. (
                        2026111002      ; Serial  (YYYYMMDDNN)
                              3600      ; Refresh (1 hour)
                               600      ; Retry   (10 min)
                           2419200      ; Expire  (4 weeks)
                            604800 )    ; Negative Cache TTL (1 week)

; --- Name Server ---
@       IN      NS      ns.cloud.local.

; --- NS record ---
ns      IN      A       10.10.10.50

; --- Service A Records ---
web-frontend-server     IN      A       10.10.10.10
web-frontend-server2    IN      A       10.10.10.11
app-backend             IN      A       10.10.10.20
application-backend-server IN  A       10.10.10.20
relational-database-server IN  A       10.10.10.25
minio                   IN      A       10.10.10.30
object-storage-server   IN      A       10.10.10.30
keycloak                IN      A       10.10.10.40
authentication-identity-server IN A    10.10.10.40
internal-dns-server     IN      A       10.10.10.50
node-exporter           IN      A       10.10.10.60
monitoring-prometheus-server IN A      10.10.10.61
monitoring-grafana-dashboard-server IN A 10.10.10.62
api-gateway-proxy-server IN    A       10.10.10.70
